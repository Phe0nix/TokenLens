{
  "manifest_version": 3,
  "name": "Palext — Design Token Extractor",
  "version": "1.0.0",
  "description": "Extract design tokens from websites, inspect elements, and export via unified modal to CSS, SCSS, Tailwind, MUI, Ant Design, Chakra UI, Figma, DTCG, and JSON.",
  "permissions": ["storage", "activeTab", "clipboardWrite", "scripting", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Palext",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Palext"
    }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["js/content.js"],
    "run_at": "document_idle"
  }]
}
