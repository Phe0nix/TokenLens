{
  "manifest_version": 3,
  "name": "Palext — Design Token Extractor",
  "version": "1.0.1",
  "description": "Extract design tokens from any website. Export to CSS, Tailwind, Figma, MUI & more. Inspect elements, audit, and compare snapshots.",
  "permissions": ["storage", "activeTab", "clipboardWrite", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Palext",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "commands": {
    "open_classic_popup": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Palext floating tool"
    }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["js/content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": [
      "popup.html",
      "css/popup.css",
      "js/popup.js",
      "icons/*.png"
    ],
    "matches": ["http://*/*", "https://*/*"]
  }]
}
